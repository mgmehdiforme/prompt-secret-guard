{
  "description": "prompt-secret-guard: keep secrets out of prompts, tool results and code",
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" prompt", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Read|NotebookRead|Grep|Bash|Write|Edit|MultiEdit",
        "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" pre", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Read|Bash|Grep|WebFetch|mcp__.*",
        "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" post", "timeout": 10 } ] }
    ]
  }
}
